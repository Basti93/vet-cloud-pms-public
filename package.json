{
  "name": "vet-cloud-pms",
  "private": true,
  "version": "0.0.1",
  "packageManager": "npm@10.9.4",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "devDependencies": {
    "@lancedb/lancedb": "^0.27.2",
    "@types/aria-query": "^5.0.4",
    "@types/babel__core": "^7.20.5",
    "@types/babel__generator": "^7.27.0",
    "@types/babel__template": "^7.4.4",
    "@types/babel__traverse": "^7.28.0",
    "@types/estree": "^1.0.8",
    "@types/json-schema": "^7.0.15",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/ms": "^2.1.0",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "apache-arrow": "^21.1.0",
    "debug": "^4.4.3",
    "husky": "^9.1.7",
    "llamaindex": "^0.12.1",
    "ms": "^2.1.3",
    "tsx": "^4.21.0",
    "turbo": "^1.13.0"
  },
  "scripts": {
    "dev": "npm run dev:web",
    "dev:web": "npm run dev --workspace @vet-cloud/web",
    "dev:admin": "npm run dev --workspace admin",
    "dev:all": "turbo run dev --parallel --filter=@vet-cloud/web --filter=admin",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "rag:index": "tsx scripts/dev-rag/index.ts",
    "rag:refresh": "tsx scripts/dev-rag/refresh.ts",
    "rag:search": "tsx scripts/dev-rag/search.ts",
    "mcp:rag": "tsx mcp-servers/rag-server.ts"
  },
  "dependencies": {
    "@clerk/localizations": "^4.5.5",
    "@vercel/analytics": "1.1.4",
    "@vercel/speed-insights": "1.0.4",
    "drizzle-kit": "^0.18.1",
    "drizzle-orm": "0.45.2",
    "next-intl": "^4.9.2",
    "svix": "^1.92.2"
  }
}
