#!/bin/sh

commit_msg_file="$1"
first_line="$(head -n 1 "$commit_msg_file" | tr -d '\r')"

# Allow merge/revert/fixup/squash commits created by git
case "$first_line" in
  Merge\ *|Revert\ *|fixup!\ *|squash!\ *)
    exit 0
    ;;
esac

# Conventional Commits:
# type(scope?): subject
# Examples:
#   feat: add tenant filter
#   fix(admin): prevent proxy loop
pattern='^(feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert|security)(\([a-z0-9._/-]+\))?!?: .{1,}$'

if ! printf '%s' "$first_line" | grep -Eq "$pattern"; then
  echo "❌ Invalid commit message format."
  echo ""
  echo "Use Conventional Commits:"
  echo "  type(scope): subject"
  echo ""
  echo "Allowed types:"
  echo "  feat, fix, docs, style, refactor, perf, test, build, ci, chore, revert, security"
  echo ""
  echo "Examples:"
  echo "  feat(web): add tenant badge"
  echo "  fix(admin): forward auth header in proxy"
  echo "  chore: update lockfile"
  exit 1
fi

exit 0
