# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/dbname?sslmode=require

# Clerk Authentication (https://clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx

# Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Vapi AI Voice (https://vapi.ai)
NEXT_PUBLIC_VAPI_PUBLIC_KEY=xxx
NEXT_PUBLIC_VAPI_ASSISTANT_ID=xxx
NEXT_PUBLIC_VAPI_PHONE_NUMBER=+49_xxx

# Email Service (Resend - https://resend.com)
EMAIL_PROVIDER=resend
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=noreply@example.com

# JWT Configuration (for confirmation tokens)
JWT_SECRET=your-super-secret-key-change-in-production
