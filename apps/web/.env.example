# Database (Neon PostgreSQL)
DATABASE_URL=postgresql://user:password@ep-xxx.eu-central-1.aws.neon.tech/dbname?sslmode=require
# Note: Neon connection pooling (PgBouncer) is available with ?sslmode=require

# Clerk Authentication (https://clerk.com)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
CLERK_WEBHOOK_SECRET=whsec_xxx  # From Clerk Dashboard → Webhooks

# Clerk URLs
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_SIGN_UP_URL=/sign-up
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard
NEXT_PUBLIC_CLERK_AFTER_SIGN_UP_URL=/onboarding
# Optional override if custom Clerk domain has outages
# Keep this on a CSP-allowed Clerk CDN host
NEXT_PUBLIC_CLERK_JS_URL=https://cdn.clerk.com/npm/@clerk/clerk-js@6/dist/clerk.browser.js

# App Config
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SYSTEM_NAME=Vet Cloud PMS

# Vapi AI Voice (https://vapi.ai)
NEXT_PUBLIC_VAPI_PUBLIC_KEY=xxx
NEXT_PUBLIC_VAPI_ASSISTANT_ID=xxx
NEXT_PUBLIC_VAPI_PHONE_NUMBER=+49_xxx

# Email Service (SMTP)
# Production: use real SMTP credentials (e.g. all-inkl)
# Local dev: use Mailpit (docker compose up -d) — catches all email at localhost:8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=test
SMTP_PASS=test
SMTP_FROM=noreply@example.com
CONSULTATION_RECIPIENT_EMAIL=beratung@example.com
# Encryption key for tenant SMTP passwords stored in DB (generate: openssl rand -hex 32)
SMTP_CREDENTIAL_KEY=your-32-byte-hex-key-here

# JWT Configuration (for confirmation tokens)
JWT_SECRET=your-super-secret-key-change-in-production

# Analytics (Umami - https://umami.is)
# Set both to enable tracking. Leave empty/absent to disable (e.g. in local dev).
# NEXT_PUBLIC_UMAMI_SRC is the full URL to the tracker script (e.g. https://stats.example.com/t.js)
# NEXT_PUBLIC_UMAMI_WEBSITE_ID is the website ID from the Umami dashboard
NEXT_PUBLIC_UMAMI_SRC=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Error Tracking (Sentry - https://sentry.io)
# Optional but recommended for production
SENTRY_DSN=https://key@sentry.io/project-id

# Admin Access
# Comma-separated list of Clerk user IDs with admin access (optional)
ADMIN_CLERK_IDS=user_xxx,user_yyy

# Demo-Tenant für lokale Entwicklung (nach db:seed aus tenants-Tabelle befüllen)
# Muss mit DEMO_TENANT_ID aus scripts/test-data.ts übereinstimmen!
NEXT_PUBLIC_DEMO_TENANT_ID=2c2d9023-c9fc-4767-a1af-bc8f6fdcbaa5
DEMO_USERS_PASSWORD=change-me-demo-password

# E2E test tenant (run scripts/create-e2e-tenant.ts once to seed)
E2E_TENANT_ID=uuid-of-e2e-tenant
E2E_TENANT_SLUG=REDACTED
E2E_CLERK_USER_ID=user_xxx
E2E_EMAIL=your+e2e@gmail.com
E2E_PASSWORD=your-e2e-password
