# Playwright local test environment — copy to .env.test and fill in values
# .env.test is gitignored — never commit the real file

PLAYWRIGHT_BASE_URL=https://staging.example.com

# E2E test user (create in Clerk dashboard, link to E2E tenant in DB)
E2E_EMAIL=your+e2e@gmail.com
E2E_PASSWORD=your-e2e-password

# Clerk keys — copy from .env.local (test keys only, never prod)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
