# Playwright local test environment — copy to .env.test and fill in values
# .env.test is gitignored — never commit the real file

PLAYWRIGHT_BASE_URL=https://staging.example.com

# E2E test user (create in Clerk dashboard, link to E2E tenant via create-e2e-tenant.ts)
E2E_EMAIL=your+e2e@gmail.com
E2E_PASSWORD=your-e2e-password

# E2E tenant (must exist in DB — run scripts/create-e2e-tenant.ts once)
E2E_TENANT_ID=uuid-from-env
E2E_TENANT_SLUG=REDACTED
E2E_CLERK_USER_ID=user_xxx
E2E_PREVIEW_TOKEN=preview-token-from-reset-e2e-tenant

# Clerk keys — copy from .env.local (test keys only, never prod)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxx
CLERK_SECRET_KEY=sk_test_xxx
