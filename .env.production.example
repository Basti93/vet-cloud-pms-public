# ─────────────────────────────────────────────────────────────────────────────
#  Vet Cloud PMS — Production Environment Variables
#  Copy to .env.production and fill in all values.
#  NEVER commit .env.production to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Domains ───────────────────────────────────────────────────────────────────
APP_DOMAIN=app.yourdomain.de
ADMIN_DOMAIN=admin.yourdomain.de
NEXT_PUBLIC_APP_URL=https://app.yourdomain.de
NEXT_PUBLIC_ADMIN_URL=https://admin.yourdomain.de

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=vetcloud
POSTGRES_PASSWORD=change_me_use_a_strong_password_here
POSTGRES_DB=vetcloud
DATABASE_URL=postgres://....

# ── Clerk (EU region — get from clerk.com dashboard) ─────────────────────────
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=REDACTED
CLERK_SECRET_KEY=REDACTED
CLERK_WEBHOOK_SECRET=REDACTED
# Comma-separated Clerk user IDs that can access the admin app
ADMIN_CLERK_IDS=user_placeholder

# ── Email — Resend (resend.com) ───────────────────────────────────────────────
RESEND_API_KEY=re_...
EMAIL_FROM=noreply@yourdomain.de

# ── Vapi Voice ────────────────────────────────────────────────────────────────
VAPI_API_KEY=...
VAPI_ASSISTANT_ID=...
VAPI_WEBHOOK_SECRET=...

# ── Backup: Hetzner Object Storage (optional) ─────────────────────────────────
# Create a bucket in Hetzner Console → Object Storage
# Endpoint format: https://<region>.your-objectstorage.com
S3_ENDPOINT=https://fsn1.your-objectstorage.com
S3_BUCKET=vet-cloud-backups
S3_ACCESS_KEY=...
S3_SECRET_KEY=...
